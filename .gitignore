# Root .gitignore for ArchLens

# Gradle & Java
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
backend/.gradle/
backend/build/
backend/out/
*.class

# Node & Next.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
frontend/next-env.d.ts

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# Environment files
.env*.local
*.env

# IDE & Editor files
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath

# OS files
.DS_Store
Thumbs.db
